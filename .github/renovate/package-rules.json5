{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Skip date based images",
      matchDatasources: ["docker"],
      allowedVersions: "!/^\\d{4}.*$/",
    },
    {
      description: "Home Assistant uses CalVer (YYYY.MM.patch), don't treat it as a date-based image to skip",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-assistant/home-assistant"],
      allowedVersions: "*",
    },
    {
      description: "ytdl-sub uses CalVer (YYYY.MM.DD[.postN])",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/jmbannon/ytdl-sub-gui"],
      allowedVersions: "/^\\d{4}\\.\\d{2}\\.\\d{2}/",
      versioning: "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d{2})(\\.post(?<build>\\d+))?$",
    },
    {
      description: "Avoid old qbittorrent images",
      matchDatasources: ["docker"],
      matchPackageNames: "ghcr.io/linuxserver/qbittorrent",
      allowedVersions: "<=14.0",
    },
    {
      description: "Auto-merge GitHub Actions patch updates",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["patch", "digest"],
      ignoreTests: true,
    },
    {
      description: "Separate minor and patch for Talos/Kubernetes to enforce sequential upgrades",
      matchPackageNames: [
        "siderolabs/talos",
        "ghcr.io/siderolabs/kubelet",
      ],
      separateMinorPatch: true,
    },
    {
      description: "Auto-merge Talos/Kubernetes patch updates",
      matchPackageNames: [
        "siderolabs/talos",
        "ghcr.io/siderolabs/kubelet",
      ],
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge alpine and awscli minor updates",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/alpine", "amazon/aws-cli"],
      matchUpdateTypes: ["minor"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge all other patch updates as soon as they land (security fixes usually ship as patches); minor/major stay weekly and get a PR. Talos/k8s patches stay weekly since they trigger node upgrades.",
      matchUpdateTypes: ["patch"],
      matchPackageNames: ["!ghcr.io/siderolabs/kubelet", "!siderolabs/talos"],
      schedule: ["at any time"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
  ],
}
