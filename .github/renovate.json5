{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "docker:enableMajor",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":skipStatusChecks",
    "github>chadjvw/homelab-cosmere//.github/renovate/package-rules.json5",
    "github>chadjvw/homelab-cosmere//.github/renovate/commit-message.json5",
    "github>chadjvw/homelab-cosmere//.github/renovate/semantic-commits.json5",
    "github>chadjvw/homelab-cosmere//.github/renovate/custom-managers.json5",
  ],
  enabled: true,
  timezone: "America/Denver",
  schedule: ["on monday"],
  rebaseWhen: "conflicted",
  // Security PRs bypass the weekly schedule. GitHub advisories need Dependabot alerts enabled on the repo.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ["security"],
    schedule: ["at any time"],
  },
  "pre-commit": {
    enabled: false,
  },
  flux: {
    managerFilePatterns: ["/(apps|infra|observability)/.+\\.yaml$/", "/repos/.+\\.yaml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/apps/.+\\.yaml$/"],
  },
}
